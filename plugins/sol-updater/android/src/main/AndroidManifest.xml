<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets the app prompt the user to install the downloaded APK (Android 8+). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- No FileProvider here on purpose: the app manifest generated by
             Capacitor already declares one (authority
             "${applicationId}.fileprovider"), and the manifest merger rejects
             two providers for the same class. The plugin reuses the app's
             provider (see FILE_PROVIDER_SUFFIX); the template's file_paths
             cover the download directory. -->
    </application>
</manifest>
